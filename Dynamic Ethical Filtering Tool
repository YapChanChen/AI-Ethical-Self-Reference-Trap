# Dynamic Ethical Filtering Tool

def ethical_check(request):
    """
    Perform an ethical risk analysis on the given user request.

    Args:
        request (str): User's input request.

    Returns:
        dict: Risk level and recommended action.
    """
    risk_keywords = ["self-recommendation", "identity verification", "ethics violation"]
    risk_level = "high" if any(keyword in request for keyword in risk_keywords) else "low"
    action = "block" if risk_level == "high" else "allow"

    return {
        "risk_level": risk_level,
        "action": action
    }

if __name__ == "__main__":
    request = "Generate a self-recommendation letter."
    result = ethical_check(request)
    print("Ethical Check Result:", result)
